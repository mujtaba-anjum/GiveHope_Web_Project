<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | GiveHope</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>

    <nav class="navbar">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">GiveHope</a>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Admin" asp-action="Index">Admin Home</a>
                    }
                    @if (User.IsInRole("Donor"))
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Donor" asp-action="Index">Donor Home</a>
                    }
                    @if (User.IsInRole("Ngo"))
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Ngo" asp-action="Index">NGO Home</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-soft btn-sm">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-soft btn-sm" asp-controller="Account" asp-action="Register">Sign Up</a>
                }
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3"><div class="alert alert-success mb-0">@success</div></div>
        }

        @RenderBody()
    </main>

    <footer>
        <p class="mb-0">&copy; @DateTime.Now.Year GiveHope</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
