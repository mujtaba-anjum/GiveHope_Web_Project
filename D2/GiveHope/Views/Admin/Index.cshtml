@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Home";
}

<div class="page-title">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">Admin Home</h3>
        <span class="badge badge-soft fs-6">Total raised: Rs. @Model.TotalRaised.ToString("N0")</span>
    </div>
</div>

<div class="container">
    <div class="box">
        <h5>All Campaigns</h5>
        @if (!Model.Campaigns.Any())
        {
            <p class="text-muted mb-0">No campaigns yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Campaign</th>
                            <th>NGO</th>
                            <th>Target</th>
                            <th>Raised</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var campaign in Model.Campaigns)
                        {
                            <tr>
                                <td>@campaign.Title</td>
                                <td>@campaign.NgoName</td>
                                <td>Rs. @campaign.Target.ToString("N0")</td>
                                <td>Rs. @campaign.Raised.ToString("N0")</td>
                                <td>
                                    @if (campaign.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (campaign.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@campaign.Status</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (campaign.Status == "Pending")
                                    {
                                        <form asp-action="ApproveCampaign" asp-route-id="@campaign.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-soft btn-sm">Approve</button>
                                        </form>
                                        <form asp-action="RejectCampaign" asp-route-id="@campaign.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-peach btn-sm">Reject</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
